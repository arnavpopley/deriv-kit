# Daily bearer token (Groww → profile → Settings → Trading APIs).
# Expires every day at 06:00 IST.
GROWW_ACCESS_TOKEN=

# Alternative: API key + secret (checksum) or TOTP.
# GROWW_API_KEY=
# GROWW_API_SECRET=
# GROWW_TOTP=

# Optional overrides
GROWW_UNDERLYING=NIFTY
# GROWW_EXPIRY=2026-09-29
# GROWW_FIXTURE=examples/data/nifty_chain.json
